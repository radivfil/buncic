---
/* Sekcija s obrascem za upit: naslov i kontakt lijevo, obrazac desno */
import Obrazac from './Obrazac.astro';
import Ikona from './Ikona.astro';
import { getEntry } from 'astro:content';
import { telHref } from '../lib/kontakt';
import Telefon from './Telefon.astro';

interface Props {
  naslov: string;
  opis: string;
  vrsta: 'dogadjaj' | 'smjestaj' | 'opci';
  prigoda?: string;
  tamno?: boolean;
  id?: string;
}

const { naslov, opis, vrsta, prigoda, tamno = false, id = 'upit' } = Astro.props;
const postavke = (await getEntry('postavke', 'opce'))!.data;
---

<section id={id} class:list={['scroll-mt-24', tamno ? 'bg-podrum-800 text-krem' : 'bg-pozadina-2/60']}>
  <div class="okvir grid gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
    <div class="lg:col-span-4" data-reveal>
      <h2 class="text-4xl leading-[1.1] tracking-tight md:text-5xl">{naslov}</h2>
      <p class:list={['mt-6 max-w-[40ch] text-lg leading-relaxed', tamno ? 'text-krem/80' : 'text-tekst-meki']}>{opis}</p>
      <ul class:list={['mt-10 space-y-4', tamno ? 'text-krem/85' : 'text-tekst']}>
        <li>
          <a href={telHref(postavke.telefon)} class="inline-flex min-h-11 items-center gap-3 hover:underline">
            <Ikona ime="phone" velicina={22} class={tamno ? 'text-zlato' : 'text-naglasak'} /> <Telefon broj={postavke.telefon} />
          </a>
        </li>
        <li>
          <a href={telHref(postavke.mobitel)} class="inline-flex min-h-11 items-center gap-3 hover:underline">
            <Ikona ime="device-mobile" velicina={22} class={tamno ? 'text-zlato' : 'text-naglasak'} /> <Telefon broj={postavke.mobitel} />
          </a>
        </li>
        <li>
          <a href={`mailto:${postavke.email}`} class="inline-flex min-h-11 items-center gap-3 hover:underline">
            <Ikona ime="envelope-simple" velicina={22} class={tamno ? 'text-zlato' : 'text-naglasak'} /> {postavke.email}
          </a>
        </li>
      </ul>
      <slot name="ispod" />
    </div>
    <div class:list={['lg:col-span-8', !tamno && 'bg-pozadina p-6 sm:p-10']} data-reveal>
      <Obrazac vrsta={vrsta} prigoda={prigoda} tamno={tamno} id={`${id}-obrazac`} />
    </div>
  </div>
</section>
