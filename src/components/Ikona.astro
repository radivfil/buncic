---
/*
  Phosphor ikone (Light), učitane kao inline SVG u build vremenu.
  Nema JS-a na klijentu; boja se nasljeđuje preko currentColor.
*/
const svgs = import.meta.glob<string>(
  '/node_modules/@phosphor-icons/core/assets/light/*.svg',
  { query: '?raw', import: 'default', eager: true },
);

interface Props {
  ime: string;
  class?: string;
  velicina?: number;
}

const { ime, class: klasa = '', velicina = 20 } = Astro.props;
const kljuc = `/node_modules/@phosphor-icons/core/assets/light/${ime}-light.svg`;
const izvor = svgs[kljuc];
if (!izvor) throw new Error(`Ikona "${ime}" ne postoji u Phosphor Light setu.`);

const svg = izvor
  .replace('<svg ', `<svg width="${velicina}" height="${velicina}" aria-hidden="true" focusable="false" class="${klasa}" `)
  .replace(/fill="#000000"/g, 'fill="currentColor"');
---

<Fragment set:html={svg} />
