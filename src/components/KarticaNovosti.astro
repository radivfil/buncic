---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Ikona from './Ikona.astro';
import { formatirajDatum } from '../lib/datum';

interface Props {
  objava: CollectionEntry<'novosti'>;
  velika?: boolean;
  vodoravna?: boolean;
}

const { objava, velika = false, vodoravna = false } = Astro.props;
const { naslov, datum, sazetak, naslovnica, naslovnicaAlt, kategorija } = objava.data;
const href = `/novosti/${objava.id}`;
---

<article
  class:list={['group relative', vodoravna && 'grid grid-cols-[112px_1fr] gap-5 xs:grid-cols-[150px_1fr] sm:grid-cols-[200px_1fr] sm:gap-6']}
  data-kartica
>
  <div class:list={['overflow-hidden bg-pozadina-2', velika ? 'aspect-[4/3]' : vodoravna ? 'aspect-[4/5]' : 'aspect-[4/5]']}>
    <Picture
      src={naslovnica}
      alt={naslovnicaAlt}
      formats={['avif', 'webp']}
      widths={velika ? [640, 960, 1280] : [320, 480, 640]}
      sizes={velika ? '(min-width: 1024px) 55vw, 100vw' : vodoravna ? '200px' : '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw'}
      class="h-full w-full object-cover"
      data-kartica-slika
    />
  </div>
  <div class:list={[!vodoravna && 'mt-6']}>
    <p class="text-sm text-tekst-meki">
      <span class="font-medium text-naglasak">{kategorija}</span>
      <span aria-hidden="true" class="mx-2">/</span>
      <time datetime={datum.toISOString().slice(0, 10)}>{formatirajDatum(datum)}</time>
    </p>
    <h3 class:list={['mt-3 font-display leading-snug', velika ? 'text-3xl md:text-4xl' : 'text-xl sm:text-2xl']}>
      <a href={href} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
        {naslov}
      </a>
    </h3>
    {(velika || !vodoravna) && <p class="mt-3 max-w-[60ch] leading-relaxed text-tekst-meki">{sazetak}</p>}
    {
      velika && (
        <p class="mt-5 inline-flex items-center gap-2 font-medium text-naglasak">
          Pročitajte više
          <span data-kartica-strelica class="inline-flex">
            <Ikona ime="arrow-right" velicina={18} />
          </span>
        </p>
      )
    }
  </div>
</article>
