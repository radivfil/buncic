---
/*
  Potpisni modul "Koliko gostiju očekujete?".
  Klizač i polje za broj su sinkronizirani; dvorane čiji raspon odgovara
  ističu se, ostale se utišaju, a prva odgovarajuća se skrola u vidno polje.
  Vanilla JS (~1 kB), bez frameworka. Broj gostiju se čita i iz URL-a (?gosti=120)
  pa poveznica s početne stranice otvara već filtriran prikaz.
*/
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Ikona from './Ikona.astro';
import DemoOznaka from './DemoOznaka.astro';

const dvorane = (await getCollection('dvorane')).sort((a, b) => a.data.redoslijed - b.data.redoslijed);
const min = Math.min(...dvorane.map((d) => d.data.min));
const max = Math.max(...dvorane.map((d) => d.data.max));
const pocetno = 120;
const svePotvrdeno = dvorane.every((d) => d.data.potvrdeno);
---

<section id="dvorane" class="odabir scroll-mt-24 py-24 lg:py-32" aria-labelledby="dvorane-naslov" data-odabir>
  <div class="okvir">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <h2 id="dvorane-naslov" class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>Koliko gostiju očekujete?</h2>
        <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-tekst-meki" data-reveal>
          Pomaknite klizač i pokazat ćemo vam dvoranu koja odgovara vašem slavlju.
          <DemoOznaka potvrdeno={svePotvrdeno} tekst="Kapaciteti su primjer" class="ml-1 align-middle" />
        </p>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <div class="flex items-end justify-between gap-6">
          <label for="broj-gostiju" class="text-sm font-medium text-tekst-meki">Broj gostiju</label>
          <div class="flex items-baseline gap-2">
            <input
              id="broj-gostiju-polje"
              type="number"
              inputmode="numeric"
              min={min}
              max={max}
              value={pocetno}
              aria-label="Broj gostiju, upis"
              class="w-40 border-b-2 border-naglasak bg-transparent text-right font-display text-5xl tabular-nums leading-none text-tekst md:text-6xl"
              data-broj
            />
          </div>
        </div>
        <input
          id="broj-gostiju"
          type="range"
          min={min}
          max={max}
          step="10"
          value={pocetno}
          class="klizac mt-6 w-full"
          aria-describedby="odabir-rezultat"
          data-klizac
        />
        <div class="mt-2 flex justify-between text-xs tabular-nums text-tekst-meki" aria-hidden="true">
          <span>{min}</span><span>{max}</span>
        </div>
        <p id="odabir-rezultat" class="mt-5 min-h-[3.5rem] text-lg text-tekst" role="status" aria-live="polite" data-rezultat></p>
      </div>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-dvorane>
      {
        dvorane.map((d) => (
          <li
            class="dvorana relative flex flex-col bg-pozadina-2"
            data-min={d.data.min}
            data-max={d.data.max}
            data-naziv={d.data.naziv}
            id={`dvorana-${d.id}`}
          >
            <div class="aspect-[4/3] overflow-hidden">
              <Picture
                src={d.data.slika}
                alt={d.data.alt}
                formats={['avif', 'webp']}
                widths={[400, 640, 900]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="oznaka-preporuka hidden items-center gap-1.5 text-sm font-medium text-naglasak">
                <Ikona ime="check-circle" velicina={18} /> Odgovara vašem broju gostiju
              </p>
              <h3 class="mt-1 font-display text-2xl leading-tight">{d.data.naziv}</h3>
              <p class="mt-2 text-sm leading-relaxed text-tekst-meki">{d.data.opis}</p>
              <dl class="mt-auto grid grid-cols-2 gap-3 border-t border-rub/15 pt-4 text-sm">
                <div>
                  <dt class="text-tekst-meki">Kapacitet</dt>
                  <dd class="font-display text-xl tabular-nums">{d.data.min} - {d.data.max}</dd>
                </div>
                <div>
                  <dt class="text-tekst-meki">{d.data.konfiguracije[0].tip}</dt>
                  <dd class="font-display text-xl tabular-nums">do {d.data.konfiguracije[0].gosti}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dvorana {
    transition: opacity 0.4s var(--ease-out-soft), transform 0.4s var(--ease-out-soft), box-shadow 0.4s;
  }
  /* Utišava se samo fotografija; tekst zadržava puni kontrast (WCAG AA) */
  .dvorana :global(img) {
    transition: opacity 0.4s, filter 0.4s;
  }
  .dvorana[data-stanje='ne'] :global(img) {
    opacity: 0.4;
    filter: grayscale(1);
  }
  .dvorana[data-stanje='da'] {
    box-shadow: inset 0 0 0 2px var(--color-naglasak);
  }
  .dvorana[data-stanje='da'] .oznaka-preporuka {
    display: inline-flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dvorana[data-stanje='da'] {
      transform: translateY(-4px);
    }
  }
  /* Klizač u bojama teme */
  .klizac {
    appearance: none;
    height: 44px;
    background: transparent;
    cursor: pointer;
  }
  .klizac::-webkit-slider-runnable-track {
    height: 2px;
    background: color-mix(in srgb, var(--color-rub) 25%, transparent);
  }
  .klizac::-moz-range-track {
    height: 2px;
    background: color-mix(in srgb, var(--color-rub) 25%, transparent);
  }
  .klizac::-webkit-slider-thumb {
    appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -13px;
    border-radius: 999px;
    background: var(--color-naglasak);
    border: 4px solid var(--color-pozadina);
    box-shadow: 0 0 0 1px var(--color-naglasak);
  }
  .klizac::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-naglasak);
    border: 4px solid var(--color-pozadina);
    box-shadow: 0 0 0 1px var(--color-naglasak);
  }
</style>

<script>
  const odabir = document.querySelector<HTMLElement>('[data-odabir]');
  if (odabir) {
    const klizac = odabir.querySelector<HTMLInputElement>('[data-klizac]')!;
    const broj = odabir.querySelector<HTMLInputElement>('[data-broj]')!;
    const rezultat = odabir.querySelector<HTMLElement>('[data-rezultat]')!;
    const dvorane = [...odabir.querySelectorAll<HTMLElement>('[data-dvorane] > li')];
    const min = Number(klizac.min);
    const max = Number(klizac.max);
    const smanjeno = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const primijeni = (n: number, skrolaj: boolean) => {
      const gosti = Math.min(max, Math.max(min, Math.round(n) || min));
      const odgovaraju = dvorane.filter((d) => gosti >= Number(d.dataset.min) && gosti <= Number(d.dataset.max));
      dvorane.forEach((d) => (d.dataset.stanje = odgovaraju.includes(d) ? 'da' : 'ne'));
      const nazivi = odgovaraju.map((d) => d.dataset.naziv);
      rezultat.textContent = nazivi.length
        ? `Za ${gosti} gostiju preporučujemo: ${nazivi.join(', ')}.`
        : `Za ${gosti} gostiju javite nam se, rado ćemo predložiti rješenje.`;
      if (skrolaj && odgovaraju[0] && innerWidth < 1024) {
        odgovaraju[0].scrollIntoView({ behavior: smanjeno ? 'auto' : 'smooth', block: 'nearest' });
      }
      return gosti;
    };

    klizac.addEventListener('input', () => {
      broj.value = klizac.value;
      primijeni(Number(klizac.value), false);
    });
    // Skrolanje tek kad korisnik pusti klizač, da se stranica ne trese tijekom povlačenja
    klizac.addEventListener('change', () => primijeni(Number(klizac.value), true));
    broj.addEventListener('change', () => {
      const g = primijeni(Number(broj.value), true);
      broj.value = String(g);
      klizac.value = String(g);
    });

    const izUrla = Number(new URLSearchParams(location.search).get('gosti'));
    const start = izUrla > 0 ? izUrla : Number(klizac.value);
    const g = primijeni(start, false);
    broj.value = String(g);
    klizac.value = String(g);
  }
</script>
