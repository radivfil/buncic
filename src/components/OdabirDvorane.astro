---
/*
  Potpisni modul "Koliko gostiju očekujete?".
  Klizač i polje za broj su sinkronizirani; dvorane čiji maksimalni kapacitet
  nije manji od broja gostiju ističu se, ostale se utišaju, a prva odgovarajuća se skrola u vidno polje.
  Vanilla JS (~1 kB), bez frameworka. Broj gostiju se čita i iz URL-a (?gosti=120)
  pa poveznica s početne stranice otvara već filtriran prikaz.

  Klik na fotografiju dvorane otvara preglednik slika (sve fotografije iz niza
  images te dvorane u dvorane.json). Nova fotografija = novi element u nizu, bez diranja koda.

  Ista komponenta je na Vjenčanjima i na Proslavama (isti podaci iz dvorane.json):
  - naslov / podnaslov: neobavezno, inače tekstovi iz stranice/vjencanja.json (odabir);
  - klizac={false}: samo kartice s preglednikom, bez klizača "Koliko gostiju" (kartice rade i bez njega).
*/
import { Picture, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Ikona from './Ikona.astro';
import DemoOznaka from './DemoOznaka.astro';

interface Props {
  naslov?: string;
  podnaslov?: string;
  klizac?: boolean;
}
const { klizac = true, ...tekstovi } = Astro.props;

const dvorane = (await getCollection('dvorane')).sort((a, b) => a.data.redoslijed - b.data.redoslijed);
// Dvorana odgovara ako je broj gostiju <= njezin maksimalni kapacitet; nema više donje granice po dvorani.
// Gornja granica klizača = najveći kapacitet dvorane (za više gostiju vrijedi napomena o spajanju dvorana).
const min = 10;
const max = Math.max(...dvorane.map((d) => d.data.kapacitet));
const pocetno = 120;
const svePotvrdeno = dvorane.every((d) => d.data.potvrdeno);
// Tekstovi modula: odabir u src/content/stranice/vjencanja.json
const t = { ...(await getEntry('stranicaVjencanja', 'vjencanja'))!.data.odabir, ...tekstovi };

// Velike verzije za preglednik (placeholderi bez src se preskaču)
const slikePreglednika = await Promise.all(
  dvorane.map((d) =>
    Promise.all(
      d.data.images
        .filter((s) => s.src)
        .map(async (s) => ({ src: (await getImage({ src: s.src!, width: 1600, format: 'webp' })).src, alt: s.alt })),
    ),
  ),
);
---

<section id="dvorane" class="odabir scroll-mt-24 py-24 lg:py-32" aria-labelledby="dvorane-naslov" data-odabir>
  <div class="okvir">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <h2 id="dvorane-naslov" class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>{t.naslov}</h2>
        <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-tekst-meki" data-reveal>
          {t.podnaslov}
          <DemoOznaka potvrdeno={svePotvrdeno} tekst={t.oznakaPrimjer} class="ml-1 align-middle" />
        </p>
      </div>
      {klizac && (
      <div class="lg:col-span-6" data-reveal>
        <div class="flex items-end justify-between gap-6">
          <label for="broj-gostiju" class="text-sm font-medium text-tekst-meki">Broj gostiju</label>
          <div class="flex items-baseline gap-2">
            <input
              id="broj-gostiju-polje"
              type="number"
              inputmode="numeric"
              min={min}
              max={max}
              value={pocetno}
              aria-label="Broj gostiju, upis"
              class="w-40 border-b-2 border-naglasak bg-transparent text-right font-display text-5xl tabular-nums leading-none text-tekst md:text-6xl"
              data-broj
            />
          </div>
        </div>
        <input
          id="broj-gostiju"
          type="range"
          min={min}
          max={max}
          step="10"
          value={pocetno}
          class="klizac mt-6 w-full"
          aria-describedby="odabir-rezultat"
          data-klizac
        />
        <div class="mt-2 flex justify-between text-xs tabular-nums text-tekst-meki" aria-hidden="true">
          <span>{min}</span><span>{max}</span>
        </div>
        <p id="odabir-rezultat" class="mt-5 min-h-[3.5rem] text-lg text-tekst" role="status" aria-live="polite" data-rezultat></p>
      </div>
      )}
    </div>

    <p class="mt-14 text-lg leading-relaxed text-tekst-meki" data-reveal>{t.napomenaSpajanje}</p>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-dvorane>
      {
        dvorane.map((d, i) => (
          <li
            class="dvorana relative flex flex-col bg-pozadina-2"
            data-max={d.data.kapacitet}
            data-naziv={d.data.naziv}
            id={`dvorana-${d.id}`}
          >
            {d.data.images[0].src ? (
              <button
                type="button"
                class="group block aspect-[4/3] w-full overflow-hidden"
                aria-label={`Otvori fotografije: ${d.data.naziv} (${slikePreglednika[i].length})`}
                aria-haspopup="dialog"
                data-preglednik-otvori
                data-naziv={d.data.naziv}
                data-slike={JSON.stringify(slikePreglednika[i])}
              >
                <Picture
                  src={d.data.images[0].src}
                  alt={d.data.images[0].alt}
                  formats={['avif', 'webp']}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
                />
              </button>
            ) : (
              /* TODO-slika: placeholder po obrascu projekta (isprekidani okvir, kao "Fotografije soba") */
              <div class="flex aspect-[4/3] flex-col items-center justify-center gap-3 border border-dashed border-rub/30">
                <Ikona ime="camera-plus" velicina={36} class="text-naglasak" />
                <DemoOznaka tekst="TODO-slika" />
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <p class="oznaka-preporuka hidden items-center gap-1.5 text-sm font-medium text-naglasak">
                <Ikona ime="check-circle" velicina={18} /> Odgovara vašem broju gostiju
              </p>
              <h3 class="mt-1 font-display text-2xl leading-tight">{d.data.naziv}</h3>
              <p class="mt-2 flex-grow text-sm leading-relaxed text-tekst-meki">{d.data.opis}</p>
              <div class="mt-6 border-t border-rub/15 pt-4 text-sm">
                {d.data.oznakaKapaciteta ? (
                  <dl>
                    <dt class="text-tekst-meki">{d.data.oznakaKapaciteta}</dt>
                    <dd class="font-display text-xl tabular-nums">do {d.data.kapacitet} osoba</dd>
                  </dl>
                ) : (
                  <p class="font-display text-xl tabular-nums">do {d.data.kapacitet} osoba</p>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Preglednik slika dvorana (lightbox). Native <dialog> + showModal: pozadina je inertna, Esc zatvara. -->
<dialog
  class="preglednik m-auto max-h-none max-w-none overscroll-contain bg-transparent p-0 text-krem backdrop:bg-podrum/90"
  role="dialog"
  aria-modal="true"
  aria-labelledby="preglednik-naslov"
  data-preglednik
>
  <div class="relative flex h-dvh w-screen flex-col items-center justify-center px-4 pb-6 pt-20 md:px-20 md:pb-10" data-preglednik-pozadina>
    <figure class="flex max-h-full min-h-0 max-w-full flex-col items-center">
      <!-- src i alt postavlja skripta pri otvaranju (lijeno učitavanje) -->
      <img alt="" loading="lazy" decoding="async" class="max-h-[calc(100dvh-9rem)] min-h-0 max-w-full object-contain" data-preglednik-slika />
      <figcaption class="mt-4 flex items-baseline gap-4 text-sm">
        <span id="preglednik-naslov" class="font-display text-xl" data-preglednik-naziv></span>
        <span class="tabular-nums text-krem/80" aria-live="polite" data-preglednik-brojac></span>
      </figcaption>
    </figure>
    <button type="button" class="absolute right-3 top-3 inline-flex h-12 w-12 items-center justify-center bg-podrum/70 text-krem" aria-label="Zatvori pregled" data-preglednik-zatvori>
      <Ikona ime="x" velicina={26} />
    </button>
    <button type="button" class="absolute left-3 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center bg-podrum/70 text-krem" aria-label="Prethodna fotografija" data-preglednik-prev>
      <Ikona ime="caret-left" velicina={26} />
    </button>
    <button type="button" class="absolute right-3 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center bg-podrum/70 text-krem" aria-label="Sljedeća fotografija" data-preglednik-next>
      <Ikona ime="caret-right" velicina={26} />
    </button>
  </div>
</dialog>

<style>
  .dvorana {
    transition: opacity 0.4s var(--ease-out-soft), transform 0.4s var(--ease-out-soft), box-shadow 0.4s;
  }
  /* Utišava se samo fotografija; tekst zadržava puni kontrast (WCAG AA) */
  .dvorana :global(img) {
    transition: opacity 0.4s, filter 0.4s;
  }
  .dvorana[data-stanje='ne'] :global(img) {
    opacity: 0.4;
    filter: grayscale(1);
  }
  .dvorana[data-stanje='da'] {
    box-shadow: inset 0 0 0 2px var(--color-naglasak);
  }
  .dvorana[data-stanje='da'] .oznaka-preporuka {
    display: inline-flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dvorana[data-stanje='da'] {
      transform: translateY(-4px);
    }
  }
  /* Klizač u bojama teme */
  .klizac {
    appearance: none;
    height: 44px;
    background: transparent;
    cursor: pointer;
  }
  .klizac::-webkit-slider-runnable-track {
    height: 2px;
    background: color-mix(in srgb, var(--color-rub) 25%, transparent);
  }
  .klizac::-moz-range-track {
    height: 2px;
    background: color-mix(in srgb, var(--color-rub) 25%, transparent);
  }
  .klizac::-webkit-slider-thumb {
    appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -13px;
    border-radius: 999px;
    background: var(--color-naglasak);
    border: 4px solid var(--color-pozadina);
    box-shadow: 0 0 0 1px var(--color-naglasak);
  }
  .klizac::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-naglasak);
    border: 4px solid var(--color-pozadina);
    box-shadow: 0 0 0 1px var(--color-naglasak);
  }
</style>

<script>
  import { animate } from 'motion';

  // Preglednik slika dvorana
  const preglednik = document.querySelector<HTMLDialogElement>('[data-preglednik]');
  if (preglednik) {
    const img = preglednik.querySelector<HTMLImageElement>('[data-preglednik-slika]')!;
    const naziv = preglednik.querySelector<HTMLElement>('[data-preglednik-naziv]')!;
    const brojac = preglednik.querySelector<HTMLElement>('[data-preglednik-brojac]')!;
    const zatvori = preglednik.querySelector<HTMLButtonElement>('[data-preglednik-zatvori]')!;
    const prev = preglednik.querySelector<HTMLButtonElement>('[data-preglednik-prev]')!;
    const next = preglednik.querySelector<HTMLButtonElement>('[data-preglednik-next]')!;
    const smanjenoKretanje = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    let slike: { src: string; alt: string }[] = [];
    let trenutna = 0;
    let izvor: HTMLElement | null = null;

    // Susjedne slike se dohvaćaju unaprijed da listanje bude trenutno
    const preducitaj = (i: number) => {
      if (slike.length < 2) return;
      new Image().src = slike[(i + slike.length) % slike.length].src;
    };
    const pokazi = (i: number) => {
      trenutna = (i + slike.length) % slike.length;
      img.src = slike[trenutna].src;
      img.alt = slike[trenutna].alt;
      brojac.textContent = `${trenutna + 1} / ${slike.length}`;
      preducitaj(trenutna + 1);
      preducitaj(trenutna - 1);
      if (!smanjenoKretanje()) {
        animate(img, { opacity: [0, 1], scale: [0.97, 1] }, { duration: 0.4, ease: [0.16, 1, 0.3, 1] });
      }
    };
    const otvori = (gumb: HTMLElement) => {
      slike = JSON.parse(gumb.dataset.slike || '[]');
      if (!slike.length) return;
      izvor = gumb;
      naziv.textContent = gumb.dataset.naziv || '';
      prev.hidden = next.hidden = slike.length < 2;
      pokazi(0);
      document.documentElement.style.overflow = 'hidden';
      preglednik.showModal();
      zatvori.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-preglednik-otvori]').forEach((g) => g.addEventListener('click', () => otvori(g)));
    zatvori.addEventListener('click', () => preglednik.close());
    prev.addEventListener('click', () => pokazi(trenutna - 1));
    next.addEventListener('click', () => pokazi(trenutna + 1));
    // Klik izvan slike (na tamnu pozadinu) zatvara
    preglednik.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === preglednik || t.hasAttribute('data-preglednik-pozadina') || t.tagName === 'FIGURE') preglednik.close();
    });
    preglednik.addEventListener('keydown', (e) => {
      if (slike.length > 1 && e.key === 'ArrowLeft') pokazi(trenutna - 1);
      if (slike.length > 1 && e.key === 'ArrowRight') pokazi(trenutna + 1);
      // Fokus ostaje zarobljen unutar preglednika
      if (e.key === 'Tab') {
        e.preventDefault();
        const fokusabilni = [zatvori, prev, next].filter((b) => !b.hidden);
        const i = fokusabilni.indexOf(document.activeElement as HTMLButtonElement);
        fokusabilni[(i + (e.shiftKey ? -1 : 1) + fokusabilni.length) % fokusabilni.length].focus();
      }
    });
    // Swipe lijevo / desno na dodirnim zaslonima
    let dodirX: number | null = null;
    let dodirY = 0;
    preglednik.addEventListener(
      'touchstart',
      (e) => {
        dodirX = e.touches[0].clientX;
        dodirY = e.touches[0].clientY;
      },
      { passive: true },
    );
    preglednik.addEventListener('touchend', (e) => {
      if (dodirX === null || slike.length < 2) return;
      const dx = e.changedTouches[0].clientX - dodirX;
      const dy = e.changedTouches[0].clientY - dodirY;
      dodirX = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) pokazi(trenutna + (dx < 0 ? 1 : -1));
    });
    // Esc (native cancel), gumb X i klik izvan slike završavaju ovdje
    preglednik.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      izvor?.focus();
    });
  }

  const odabir = document.querySelector<HTMLElement>('[data-odabir]');
  // Bez klizača (klizac={false}) kartice ostaju statične, preglednik slika radi i dalje
  if (odabir?.querySelector('[data-klizac]')) {
    const klizac = odabir.querySelector<HTMLInputElement>('[data-klizac]')!;
    const broj = odabir.querySelector<HTMLInputElement>('[data-broj]')!;
    const rezultat = odabir.querySelector<HTMLElement>('[data-rezultat]')!;
    const dvorane = [...odabir.querySelectorAll<HTMLElement>('[data-dvorane] > li')];
    const min = Number(klizac.min);
    const max = Number(klizac.max);
    const smanjeno = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const primijeni = (n: number, skrolaj: boolean) => {
      const gosti = Math.min(max, Math.max(min, Math.round(n) || min));
      const odgovaraju = dvorane.filter((d) => gosti <= Number(d.dataset.max));
      dvorane.forEach((d) => (d.dataset.stanje = odgovaraju.includes(d) ? 'da' : 'ne'));
      const nazivi = odgovaraju.map((d) => d.dataset.naziv);
      rezultat.textContent = nazivi.length
        ? `Za ${gosti} gostiju preporučujemo: ${nazivi.join(', ')}.`
        : `Za ${gosti} gostiju javite nam se, rado ćemo predložiti rješenje.`;
      if (skrolaj && odgovaraju[0] && innerWidth < 1024) {
        odgovaraju[0].scrollIntoView({ behavior: smanjeno ? 'auto' : 'smooth', block: 'nearest' });
      }
      return gosti;
    };

    klizac.addEventListener('input', () => {
      broj.value = klizac.value;
      primijeni(Number(klizac.value), false);
    });
    // Skrolanje tek kad korisnik pusti klizač, da se stranica ne trese tijekom povlačenja
    klizac.addEventListener('change', () => primijeni(Number(klizac.value), true));
    broj.addEventListener('change', () => {
      const g = primijeni(Number(broj.value), true);
      broj.value = String(g);
      klizac.value = String(g);
    });

    const izUrla = Number(new URLSearchParams(location.search).get('gosti'));
    const start = izUrla > 0 ? izUrla : Number(klizac.value);
    const g = primijeni(start, false);
    broj.value = String(g);
    klizac.value = String(g);
  }
</script>
