---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import Osnovni from '../../layouts/Osnovni.astro';
import Ikona from '../../components/Ikona.astro';
import OdabirDvorane from '../../components/OdabirDvorane.astro';
import SekcijaUpit from '../../components/SekcijaUpit.astro';
import GumbDokument from '../../components/GumbDokument.astro';
import VinskiBlagdani from '../../components/VinskiBlagdani.astro';
import { dokumentiStranice } from '../../lib/dokumenti';

const unos = (await getEntry('ponuda', 'proslave'))!;
const d = unos.data;

// Prigode: src/content/sekcije/proslave-prigode.json; uvod dvorana: proslave-dvorane.json
const prigode = (await getEntry('sekcije', 'proslave-prigode'))!.data;
const dvorane = (await getEntry('sekcije', 'proslave-dvorane'))!.data;
// Jelovnici za preuzimanje: src/content/dokumenti/dokumenti.json (stranica: proslave)
const dokumenti = await dokumentiStranice('proslave');
---

<Osnovni naslov={d.seoNaslov} opis={d.seoOpis} slika={d.naslovnica}>
  <!-- UVOD: naslov iznad, široka fotografija ispod -->
  <section class="okvir pb-12 pt-16 lg:pt-24">
    <div data-hero>
      <h1 class="text-5xl leading-[1.05] tracking-tight md:text-6xl lg:text-7xl">
        Proslave i <em class="italic text-naglasak">svečanosti</em>
      </h1>
      <p class="mt-6 max-w-[56ch] text-lg leading-relaxed text-tekst-meki">{d.uvod}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#upit" class="gumb-primarni">Pošaljite upit</a>
        {dokumenti.map((dok) => <GumbDokument dokument={dok} />)}
      </div>
    </div>
  </section>
  <div class="okvir" data-hero-slika>
    <div class="aspect-[4/3] overflow-hidden sm:aspect-[21/9]">
      <Picture
        src={d.naslovnica!}
        alt={d.naslovnicaAlt!}
        formats={['avif', 'webp']}
        widths={[640, 1000, 1500, 2480]}
        sizes="(min-width: 1320px) 1240px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <!-- PRIGODE: popis u dva stupca s ikonama -->
  <section class="okvir py-24 lg:py-32">
    <h2 class="max-w-[20ch] text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>{prigode.naslov}</h2>
    <ul class="mt-14 grid gap-x-16 gap-y-12 md:grid-cols-2" data-reveal-grupa>
      {
        prigode.stavke.map((p) => (
          <li class="flex gap-6" data-reveal>
            <span class="flex h-16 w-16 shrink-0 items-center justify-center bg-pozadina-2 text-naglasak">
              <Ikona ime={p.ikona!} velicina={32} />
            </span>
            <div>
              <h3 class="font-display text-2xl md:text-3xl">{p.naslov}</h3>
              <p class="mt-2 max-w-[40ch] leading-relaxed text-tekst-meki">{p.opis}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Ljubav, žene i vino: vraćeno s Izleta u prirodi na prvotno mjesto (faza 1d) -->
  <VinskiBlagdani />

  <!-- DVORANE: ista komponenta i isti podaci kao na Vjenčanjima (dvorane.json); klizač se isključuje u proslave-dvorane.json -->
  <OdabirDvorane naslov={dvorane.naslov} podnaslov={dvorane.odlomci[0]} klizac={dvorane.prikaziKlizacGostiju ?? false} />

  <SekcijaUpit
    naslov="Recite nam što slavite"
    opis="Pošaljite datum i broj gostiju, a mi ćemo predložiti dvoranu i svečani meni."
    vrsta="dogadjaj"
    prigoda="Krštenje"
  />
</Osnovni>
