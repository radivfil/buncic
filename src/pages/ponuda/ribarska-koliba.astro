---
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Osnovni from '../../layouts/Osnovni.astro';
import Ikona from '../../components/Ikona.astro';
import Galerija from '../../components/Galerija.astro';
import Karta from '../../components/Karta.astro';
import DemoOznaka from '../../components/DemoOznaka.astro';
import SekcijaUpit from '../../components/SekcijaUpit.astro';
import DokumentiStranice from '../../components/DokumentiStranice.astro';
import { shemaRadnogVremena, tekstRetka } from '../../lib/radnoVrijeme';
import { formatTelefona, kartaAria, kartaHref, telHref } from '../../lib/kontakt';
import { slika } from '../../lib/slike';

const unos = (await getEntry('ponuda', 'ribarska-koliba'))!;
const { Content } = await render(unos);
const d = unos.data;
const postavke = (await getEntry('postavke', 'opce'))!.data;
const koliba = postavke.lokacije.find((l) => l.naziv === 'Ribarska koliba')!;

// Uvod s kratkim činjenicama: src/content/sekcije/ribarska-uvod.json; kuhinja: ribarska-jela.json
const uvod = (await getEntry('sekcije', 'ribarska-uvod'))!.data;
const kuhinja = (await getEntry('sekcije', 'ribarska-jela'))!.data;
// Fotografija uz jela: src/content/slike/slike.json (ZAMIJENITI PRIJE LAUNCHA: arhivska, 960 px)
const raznjic = await slika('ribarska-raznjic');
const shema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Ribarska koliba Bunčić',
  servesCuisine: ['Riba', 'Jela s ražnja', 'Domaća kuhinja'],
  telephone: formatTelefona(koliba.telefoni[0], { nbsp: false }),
  address: { '@type': 'PostalAddress', streetAddress: 'Rugvička ulica 217', postalCode: '10370', addressLocality: 'Dugo Selo', addressCountry: 'HR' },
  geo: { '@type': 'GeoCoordinates', latitude: koliba.koordinate?.[0], longitude: koliba.koordinate?.[1] },
  openingHoursSpecification: shemaRadnogVremena(koliba),
};
---

<Osnovni naslov={d.seoNaslov} opis={d.seoOpis} slika={d.naslovnica} zaglavljePreko shema={shema}>
  <!-- HERO: jezero i terasa -->
  <section class="relative isolate flex min-h-[80dvh] items-end overflow-hidden bg-podrum text-krem">
    <div class="absolute inset-0 -z-10" data-hero-slika>
      <Picture src={d.naslovnica!} alt={d.naslovnicaAlt!} formats={['avif', 'webp']} widths={[640, 960, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-podrum/90 via-podrum/40 to-podrum/25"></div>
    <div class="okvir pb-16 pt-32 lg:pb-24" data-hero>
      <h1 class="text-6xl leading-[1.02] tracking-tight md:text-7xl lg:text-8xl">Ribarska koliba</h1>
      <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-krem/90 md:text-xl">{d.uvod}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={telHref(koliba.telefoni[0])} class="gumb-svijetli" data-nazovite-sidro><Ikona ime="phone" velicina={18} /> Rezervirajte stol</a>
        <a href="#lokacija" class="gumb-obrub-svijetli"><Ikona ime="map-trifold" velicina={18} /> Kako do nas</a>
      </div>
    </div>
  </section>

  <!-- UVOD i kratke činjenice -->
  <section class="okvir grid gap-12 py-24 lg:grid-cols-12 lg:py-32">
    <div class="lg:col-span-6" data-reveal-grupa>
      <h2 class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>{uvod.naslov}</h2>
      <div class="proza mt-8 max-w-[58ch] text-lg leading-relaxed text-tekst-meki" data-reveal><Content /></div>
    </div>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-10 self-center border-t border-rub/15 pt-10 lg:col-span-5 lg:col-start-8" data-reveal>
      {
        uvod.stavke.map((s) => (
          <div>
            <dt class="flex items-center gap-2 text-sm text-tekst-meki"><Ikona ime={s.ikona!} velicina={18} class="text-naglasak" /> {s.naslov}</dt>
            <dd class="mt-2 font-display text-2xl tabular-nums">{s.opis}</dd>
            {s.oznaka && <dd class="mt-2"><DemoOznaka tekst={s.oznaka} /></dd>}
          </div>
        ))
      }
    </dl>
  </section>

  <!-- KUHINJA: fotografija ražnja i jelovnik, tamna traka -->
  <section class="na-tamnom bg-podrum text-krem">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-[360px]" data-reveal="fade">
        <Picture src={raznjic.slika} alt={raznjic.alt} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="px-4 py-20 sm:px-6 lg:px-16 lg:py-28" data-reveal-grupa>
        <h2 class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>{kuhinja.naslov}</h2>
        {kuhinja.odlomci.map((o) => <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-krem/80" data-reveal>{o}</p>)}
        <ul class="mt-10 max-w-lg" data-reveal>
          {
            kuhinja.stavke.map((j) => (
              <li class="border-t border-krem/15 py-6">
                <h3 class="font-display text-2xl md:text-3xl">{j.naslov}</h3>
                <p class="mt-2 text-krem/75">{j.opis}</p>
              </li>
            ))
          }
        </ul>
        <!-- Cijeli jelovnik Ribarske kolibe 2026. (PDF): src/content/dokumenti/dokumenti.json -->
        <DokumentiStranice stranica="ribarska-koliba" varijanta="obrub-svijetli" class="mt-4 max-w-lg" />
      </div>
    </div>
  </section>

  <section class="okvir py-24 lg:py-32" aria-labelledby="koliba-galerija">
    <h2 id="koliba-galerija" class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>Terasa uz jezero</h2>
    <div class="mt-12">
      <Galerija slike={d.galerija} id="galerija-koliba" />
    </div>
  </section>

  <!-- LOKACIJA -->
  <section id="lokacija" class="scroll-mt-24 bg-pozadina-2/60 py-24 lg:py-32" aria-label="Lokacija i radno vrijeme">
    <div class="okvir">
      <Karta
        naziv="Ribarska koliba"
        adresa={koliba.adresa}
        kartaHref={kartaHref(koliba)}
        kartaAria={kartaAria(koliba)}
        koordinate={koliba.koordinate!}
        upute={koliba.radnoVrijeme.map(tekstRetka)}
        telefoni={koliba.telefoni}
        odmah
      />
    </div>
  </section>

  <!-- Gumb "Nazovite" uvijek dohvatljiv na mobitelu (< 768 px): lijevo dolje, chat je desno dolje.
       Skriva se dok je otvorena traka kolačića (kao i chat) i dok je na ekranu neki drugi gumb za poziv
       (hero, ispod karte), da ne prekriva sadržaj ni dupla gumbe. Na desktopu je dovoljan tel: link u heroju i uz kartu. -->
  <a href={telHref(koliba.telefoni[0])} class="nazovite-plutajuci gumb-primarni fixed bottom-4 left-4 z-[43] shadow-[0_12px_30px_-10px_rgba(29,20,17,0.6)] md:hidden" data-skriven>
    <Ikona ime="phone" velicina={18} /> Nazovite
  </a>

  <SekcijaUpit
    naslov="Najavite se ili rezervirajte slavlje"
    opis="Za veća društva, obiteljska okupljanja i manja vjenčanja uz jezero pošaljite nam poruku."
    vrsta="opci"
  />
</Osnovni>

<style>
  /* Plutajući gumb ne smije prekriti kraj podnožja: ispod 768 px podnožje dobiva prostor za njega */
  @media (max-width: 767px) {
    :global(footer) {
      padding-bottom: 5rem;
    }
    :global(html[data-kolacici-otvoreni]) .nazovite-plutajuci {
      display: none;
    }
  }
  .nazovite-plutajuci {
    transition: opacity 0.25s, visibility 0.25s, transform 0.25s var(--ease-out-soft);
  }
  .nazovite-plutajuci[data-skriven] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
  }
  @media (prefers-reduced-motion: reduce) {
    .nazovite-plutajuci {
      transition: none;
    }
  }
</style>

<script>
  // Plutajući "Nazovite" se skriva dok je na ekranu gumb za poziv u heroju ili ispod karte.
  // Kreće skriven (hero gumb je vidljiv pri učitavanju), pa nema bljeska preko sadržaja.
  const plutajuci = document.querySelector<HTMLElement>('.nazovite-plutajuci');
  const sidra = document.querySelectorAll('[data-nazovite-sidro]');
  if (plutajuci && sidra.length) {
    const vidljiva = new Set<Element>();
    const promatrac = new IntersectionObserver((unosi) => {
      unosi.forEach((u) => (u.isIntersecting ? vidljiva.add(u.target) : vidljiva.delete(u.target)));
      plutajuci.toggleAttribute('data-skriven', vidljiva.size > 0);
    });
    sidra.forEach((s) => promatrac.observe(s));
  }
</script>
