---
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Osnovni from '../../layouts/Osnovni.astro';
import Ikona from '../../components/Ikona.astro';
import Galerija from '../../components/Galerija.astro';
import SekcijaUpit from '../../components/SekcijaUpit.astro';

import DemoOznaka from '../../components/DemoOznaka.astro';

const unos = (await getEntry('ponuda', 'smjestaj'))!;
const { Content } = await render(unos);
const d = unos.data;

// Tipovi soba: src/content/sekcije/smjestaj-sobe.json
const sobe = (await getEntry('sekcije', 'smjestaj-sobe'))!.data;

// Sadržaji soba (jednaki za sve vrste soba): src/content/sekcije/smjestaj-sadrzaji.json
// Podzemna garaža: nepotvrđeno s vlasnikom, ne dirati (docs/napomene-za-kasnije.md)
const sadrzaji = (await getEntry('sekcije', 'smjestaj-sadrzaji'))!.data;

---

<Osnovni naslov={d.seoNaslov} opis={d.seoOpis} slika={d.naslovnica} zaglavljePreko>
  <!-- HERO: fotografija preko cijele širine s trakom za upit (ref. rustikalni boutique hotel) -->
  <section class="relative isolate overflow-hidden bg-podrum text-krem">
    <div class="absolute inset-0 -z-10" data-hero-slika>
      <Picture
        src={d.naslovnica!}
        alt={d.naslovnicaAlt!}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover object-[40%_50%]"
      />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-podrum/90 via-podrum/40 to-podrum/30"></div>
    <div class="okvir flex min-h-[78dvh] flex-col justify-end pb-10 pt-32" data-hero>
      <h1 class="max-w-[14ch] text-5xl leading-[1.05] tracking-tight md:text-7xl">Ostanite dan duže</h1>
      <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-krem/90">40 soba na imanju, usred vinograda i voćnjaka, nadomak Zagreba.</p>

      <form class="mt-10 grid grid-cols-2 gap-px bg-krem/20 text-tekst md:grid-cols-[1fr_1fr_0.7fr_0.7fr] lg:grid-cols-[1fr_1fr_0.7fr_0.7fr_auto]" data-brzi-upit aria-label="Brzi upit za smještaj">
        <label class="flex min-w-0 flex-col gap-1 bg-pozadina px-4 py-3">
          <span class="text-xs font-medium text-tekst-meki">Dolazak</span>
          <input type="date" name="dolazak" class="w-full min-w-0 bg-transparent text-base" />
        </label>
        <label class="flex min-w-0 flex-col gap-1 bg-pozadina px-4 py-3">
          <span class="text-xs font-medium text-tekst-meki">Odlazak</span>
          <input type="date" name="odlazak" class="w-full min-w-0 bg-transparent text-base" />
        </label>
        <label class="flex min-w-0 flex-col gap-1 bg-pozadina px-4 py-3">
          <span class="text-xs font-medium text-tekst-meki">Osobe</span>
          <input type="number" name="osobe" min="1" value="2" inputmode="numeric" class="w-full min-w-0 bg-transparent text-base" />
        </label>
        <label class="flex min-w-0 flex-col gap-1 bg-pozadina px-4 py-3">
          <span class="text-xs font-medium text-tekst-meki">Sobe</span>
          <input type="number" name="sobe" min="1" value="1" inputmode="numeric" class="w-full min-w-0 bg-transparent text-base" />
        </label>
        <button type="submit" class="gumb-primarni col-span-2 h-full min-h-14 md:col-span-4 lg:col-span-1">Provjerite dostupnost</button>
      </form>
    </div>
  </section>

  <!-- SOBE: tekst i popis tipova soba -->
  <section class="okvir grid gap-14 py-24 lg:grid-cols-12 lg:py-32">
    <div class="lg:col-span-6" data-reveal-grupa>
      <h2 class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>{sobe.naslov}</h2>
      <div class="proza mt-8 max-w-[58ch] text-lg leading-relaxed text-tekst-meki" data-reveal><Content /></div>
    </div>
    <div class="lg:col-span-5 lg:col-start-8" data-reveal>
      <ul class="border-y-2 border-naglasak/80">
        {
          sobe.stavke.map((s, i) => (
            <li class:list={['flex items-baseline justify-between gap-4 py-5', i > 0 && 'border-t border-rub/10']}>
              <span class="font-display text-2xl">{s.naslov}</span>
              <span class="text-tekst-meki">{s.opis}</span>
            </li>
          ))
        }
      </ul>
      <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-4 xs:grid-cols-2" aria-label={sadrzaji.naslov}>
        {
          sadrzaji.stavke.map((s) => (
            <li class="flex items-center gap-3">
              <Ikona ime={s.ikona!} velicina={24} class="shrink-0 text-naglasak" />
              {s.naslov}
            </li>
          ))
        }
      </ul>
      <!-- Fotografije soba: src/content/sekcije/smjestaj-sobe.json, polje galerija.
           Dok je galerija prazna, ovdje stoji rezervirano mjesto; s fotografijama se galerija prikazuje ispod sekcije. -->
      {sobe.galerija.length === 0 && (
        <div class="mt-10 flex items-center gap-5 border border-dashed border-rub/30 p-6">
          <Ikona ime="camera-plus" velicina={36} class="shrink-0 text-naglasak" />
          <div>
            <p class="font-display text-xl">Fotografije soba</p>
            <p class="mt-1 text-sm text-tekst-meki">Ovdje dolazi galerija soba: po jedna fotografija svakog tipa sobe i kupaonice.</p>
            <DemoOznaka tekst="Klijent dostavlja" class="mt-3" />
          </div>
        </div>
      )}
    </div>
  </section>

  {
    sobe.galerija.length > 0 && (
      <section class="okvir pb-24 lg:pb-32" aria-label="Fotografije soba">
        <Galerija slike={sobe.galerija} varijanta="rustik" id="galerija-sobe" />
      </section>
    )
  }

  <!-- GALERIJA: topla rustika, drveni okviri -->
  <section class="bg-pozadina-2/70 py-24 lg:py-32" aria-labelledby="imanje-naslov">
    <div class="okvir">
      <h2 id="imanje-naslov" class="max-w-[20ch] text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>Oko vas, imanje</h2>
      <div class="mt-12">
        <Galerija slike={d.galerija} varijanta="rustik" id="galerija-smjestaj" />
      </div>
    </div>
  </section>


  <SekcijaUpit
    naslov="Upit za smještaj"
    opis="Pošaljite datume i broj osoba. Javit ćemo vam se s potvrdom dostupnosti i cijenom."
    vrsta="smjestaj"
  />
</Osnovni>

<script>
  // Brzi upit iz hero trake prepisuje vrijednosti u glavni obrazac i skrolira do njega
  const brzi = document.querySelector<HTMLFormElement>('[data-brzi-upit]');
  const glavni = document.querySelector<HTMLFormElement>('form[data-obrazac="smjestaj"]');
  if (brzi && glavni) {
    const danas = new Date().toISOString().slice(0, 10);
    brzi.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((d) => (d.min = danas));
    brzi.addEventListener('submit', (e) => {
      e.preventDefault();
      for (const [k, v] of new FormData(brzi)) {
        const polje = glavni.querySelector<HTMLInputElement>(`[name="${k}"]`);
        if (polje && v) polje.value = String(v);
      }
      document.getElementById('upit')?.scrollIntoView({ behavior: 'smooth' });
      glavni.querySelector<HTMLInputElement>('[name="ime"]')?.focus({ preventScroll: true });
    });
  }
</script>
