---
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Osnovni from '../../layouts/Osnovni.astro';
import Ikona from '../../components/Ikona.astro';
import Galerija from '../../components/Galerija.astro';
import SekcijaUpit from '../../components/SekcijaUpit.astro';
import OdabirDvorane from '../../components/OdabirDvorane.astro';
import Paketi from '../../components/Paketi.astro';
import Recenzije from '../../components/Recenzije.astro';
import CestaPitanja from '../../components/CestaPitanja.astro';
import FotoTraka from '../../components/FotoTraka.astro';
import GumbDokument from '../../components/GumbDokument.astro';
import { dokumentiStranice } from '../../lib/dokumenti';

import { slika } from '../../lib/slike';
// Pojedinačne fotografije stranice: src/content/slike/slike.json
const [stablo, vatromet, dvoranaSvijece] = await Promise.all(['vjencanja-stablo', 'vjencanja-vatromet', 'vjencanja-dvorana'].map(slika));

const unos = (await getEntry('ponuda', 'vjencanja'))!;
const { Content } = await render(unos);
const d = unos.data;
// Tekstovi stranice: src/content/stranice/vjencanja.json
const t = (await getEntry('stranicaVjencanja', 'vjencanja'))!.data;

// Brošura (PDF): src/content/dokumenti/dokumenti.json (stranica: vjencanja)
const brosure = await dokumentiStranice('vjencanja');
---

<Osnovni naslov={d.seoNaslov} opis={d.seoOpis} slika={d.naslovnica} zaglavljePreko>
  <!-- HERO: emotivna fotografija preko cijelog ekrana (ref. Sundance Estate) -->
  <section class="relative isolate flex min-h-[88dvh] items-end overflow-hidden bg-podrum text-krem">
    <div class="absolute inset-0 -z-10" data-hero-slika>
      <Picture
        src={d.naslovnica!}
        alt={d.naslovnicaAlt!}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover object-[50%_45%]"
      />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-podrum/85 via-podrum/25 to-podrum/20"></div>
    <div class="okvir pb-16 pt-32 lg:pb-24" data-hero>
      <h1 class="text-6xl leading-none tracking-tight md:text-7xl lg:text-8xl">Vjenčanja</h1>
      <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-krem/90 md:text-xl">
        {t.heroPodnaslov}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#upit" class="gumb-svijetli">Provjerite termin</a>
        {brosure.map((dok) => <GumbDokument dokument={dok} varijanta="obrub-svijetli" />)}
      </div>
    </div>
  </section>

  <!-- PISMO MLADENCIMA: tekst i visoka fotografija (ref. Sundance, dvostupčano) -->
  <section class="okvir grid gap-12 py-24 md:grid-cols-12 lg:gap-20 lg:py-32">
    <div class="md:col-span-7 lg:col-span-6" data-reveal-grupa>
      <p class="max-w-[30ch] font-display text-3xl leading-snug text-naglasak md:text-4xl" data-reveal>
        {d.uvod}
      </p>
      <div class="proza mt-10 max-w-[60ch] text-lg leading-relaxed text-tekst-meki [&>p:first-child]:font-display [&>p:first-child]:text-2xl [&>p:first-child]:italic [&>p:first-child]:text-tekst" data-reveal>
        <Content />
      </div>
    </div>
    <div class="md:col-span-5 lg:col-span-5 lg:col-start-8" data-reveal="fade">
      <div class="luk aspect-[3/4] overflow-hidden">
        <Picture
          src={stablo.slika}
          alt={stablo.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- POTPISNI MODUL: koliko gostiju -> prijedlog dvorane -->
  <OdabirDvorane />

  <!-- UKLJUČENO: ljepljiva fotografija lijevo, tri cjeline desno -->
  <section class="bg-pozadina-2/60 py-24 lg:py-32">
    <div class="okvir grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <h2 class="text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>{t.ukljuceno.naslov}</h2>
          <div class="mt-10 hidden aspect-[4/3] overflow-hidden lg:block" data-reveal="fade">
            <Picture
              src={vatromet.slika}
              alt={vatromet.alt}
              formats={['avif', 'webp']}
              widths={[640, 960]}
              sizes="40vw"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-12 lg:col-span-6 lg:col-start-7" data-reveal-grupa>
        {
          t.ukljuceno.skupine.map((g) => (
            <div class="border-t border-naglasak/30 pt-8" data-reveal>
              <div class="flex items-center gap-4">
                <Ikona ime={g.ikona} velicina={32} class="text-naglasak" />
                <h3 class="font-display text-3xl">{g.naslov}</h3>
              </div>
              <ul class="mt-6 space-y-3 text-lg text-tekst-meki">
                {g.stavke.map((s) => (
                  <li class="flex gap-3">
                    <Ikona ime="check" velicina={20} class="mt-1 shrink-0 text-naglasak" />
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="relative aspect-[16/10] overflow-hidden lg:hidden" data-reveal>
          <Picture src={vatromet.slika} alt={vatromet.alt} formats={['avif', 'webp']} widths={[480, 800]} sizes="100vw" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- GALERIJA -->
  <section class="okvir py-24 lg:py-32" aria-labelledby="galerija-naslov">
    <h2 id="galerija-naslov" class="max-w-[18ch] text-4xl leading-[1.1] tracking-tight md:text-5xl" data-reveal>Vjenčanja na imanju</h2>
    <div class="mt-12">
      <Galerija slike={d.galerija} id="galerija-vjencanja" />
    </div>
  </section>

  <!-- MANIFEST: fotografija preko cijele širine s tekstom (mijenja ritam stranice) -->
  <FotoTraka slika={dvoranaSvijece.slika} alt={dvoranaSvijece.alt} poravnanje="sredina" visina="min-h-[60dvh]">
    <p class="font-display text-4xl leading-snug md:text-6xl">
      Svako vjenčanje je nova priča. <em class="italic text-zlato-300">Neka vaša bude jedinstvena.</em>
    </p>
  </FotoTraka>

  <Paketi />

  <Recenzije />

  <CestaPitanja />

  <SekcijaUpit
    naslov="Provjerite slobodan termin"
    opis="Recite nam datum i okviran broj gostiju. Javit ćemo vam se s dostupnim dvoranama i prijedlogom menija."
    vrsta="dogadjaj"
    prigoda="Vjenčanje"
  />
</Osnovni>
